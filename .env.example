# Copy this file to .env.local and fill in ONE AI key.
# .env.local is gitignored so your credentials are never committed.

# --- Option A: Google Gemini (FREE, no credit card) -------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# --- Option B: Anthropic Claude (paid, highest quality) ---------------------
# Get a key at https://console.anthropic.com/settings/keys
# If this is set, it takes priority over GEMINI_API_KEY.
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the Anthropic model (defaults to claude-opus-5)
# ANTHROPIC_MODEL=claude-sonnet-5
