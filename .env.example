# Copy this file to .env.local and fill in your Anthropic API key.
# .env.local is gitignored so your credentials are never committed.

# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for improvements (defaults to claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5
